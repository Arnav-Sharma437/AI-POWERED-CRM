# Supabase PostgreSQL Connection String (Transaction mode / Pooled connection - Port 5432 or 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="your-supabase-transaction-pooled-connection-url-here"

# Supabase Direct PostgreSQL Connection String (Session mode / Direct connection - Port 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="your-supabase-direct-non-pooled-connection-url-here"

# Secret key for signing JWT auth tokens
JWT_SECRET="generate-a-secure-secret-key-for-jwt-signing"

# Environment
NODE_ENV="development"
